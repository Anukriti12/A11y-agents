    {
      "snippet_id": "sophie_2_2_1_pass",
      "primary_persona": "sophie",
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<!-- WCAG 2.2.1 | PASS | Personas: Ade (limited mobility), Sophie (cognitive/reading)\n     Session warning appears before timeout with keyboard-accessible extend option. -->\n<head><meta charset=\"utf-8\"><title>Banking Portal</title>\n<script>\n// Simulates a session timeout warning at 19 minutes (with 1 min to respond)\nfunction showTimeoutWarning() {\n  document.getElementById('timeout-dialog').removeAttribute('hidden');\n  document.getElementById('extend-btn').focus();\n}\nfunction extendSession() {\n  document.getElementById('timeout-dialog').setAttribute('hidden', '');\n  // Reset session timer\n}\nfunction logout() { window.location.href = '/logout'; }\n</script></head>\n<body>\n  <main>\n    <h1>Account Overview</h1>\n    <p>Balance: $4,230.50</p>\n  </main>\n  <div id=\"timeout-dialog\" role=\"alertdialog\" aria-modal=\"true\" \n       aria-labelledby=\"timeout-title\" aria-describedby=\"timeout-desc\" hidden>\n    <h2 id=\"timeout-title\">Session expiring soon</h2>\n    <p id=\"timeout-desc\">Your session will expire in 60 seconds due to inactivity.\n       Would you like to continue?</p>\n    <button id=\"extend-btn\" onclick=\"extendSession()\">Continue session</button>\n    <button onclick=\"logout()\">Sign out now</button>\n  </div>\n</body>\n</html>",
      "ground_truth": {
        "sophie": {
          "label": "PASS",
